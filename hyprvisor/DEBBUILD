# Maintainer: Alexandru Balan <alxb421@gmail.com>
pkgname=hyprvisor
pkgver=26.8
pkgrel=7
pkgdesc="Additional Drivers -- hardware driver detection and installer for pearOS"
arch=('all')
url="https://github.com/Pear-Project/dpkg"
license="MIT"
section="utils"
priority="optional"
maintainer="Alexandru Balan <alxb421@gmail.com>"

builddepends=()

depends=(
    pciutils
    polkitd
    python3
    python3-gi
    gir1.2-gtk-3.0
    libnotify-bin
)

build() {
    :
}

package() {
    install -Dm755 "$startdir/hyprvisor" "$pkgdir/usr/local/sbin/hyprvisor"
    install -Dm755 "$startdir/hyprvisor-gui" "$pkgdir/usr/local/bin/hyprvisor-gui"
    install -Dm644 "$startdir/hyprvisor-gui.desktop" "$pkgdir/usr/share/applications/hyprvisor-gui.desktop"
    install -Dm644 "$startdir/hyprvisor.service" "$pkgdir/usr/lib/systemd/system/hyprvisor.service"
}

postinst="#!/bin/sh
set -e
case \"\$1\" in
    configure)
        systemctl enable hyprvisor.service || true
        ;;
esac
exit 0
"

postrm="#!/bin/sh
set -e
case \"\$1\" in
    remove)
        systemctl disable hyprvisor.service || true
        ;;
esac
exit 0
"
