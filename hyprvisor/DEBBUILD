# Maintainer: Alexandru Balan <alxb421@gmail.com>
pkgname=hyprvisor
pkgver=26.8
pkgrel=4
pkgdesc="GPU driver manager CLI + GTK GUI for pearOS, wrapping ubuntu-drivers"
arch=('amd64' 'arm64')
url="https://github.com/alxb421/hyprvisor"
license="MIT"
section="utils"
priority="optional"
maintainer="Alexandru Balan <alxb421@gmail.com>"

builddepends=(
    build-essential
    cmake
)

depends=(
    hwdata
    pciutils
    python3
    python3-gi
    gir1.2-gtk-3.0
    policykit-1
)

# ubuntu-drivers-common is Ubuntu/derivatives-only -- confirmed absent from
# stock Debian's own archive (apt-cache madison shows only archive.ubuntu.com
# sources, no debian.org entry at all). Recommends instead of a hard depends
# so the .deb still installs on stock Debian; driver_manager.cpp already
# detects its absence at runtime and reports that clearly instead of the
# misleading "nothing to install" message.
recommends=(
    ubuntu-drivers-common
)

build() {
    cmake -S "$startdir" -B "$srcdir/build" \
        -DCMAKE_BUILD_TYPE=Release
    cmake --build "$srcdir/build" --parallel
}

package() {
    install -Dm755 "$srcdir/build/hyprvisor" "$pkgdir/usr/local/bin/hyprvisor"
    install -Dm755 "$startdir/gui/hyprvisor-gui.py" "$pkgdir/usr/local/bin/hyprvisor-gui"
}
