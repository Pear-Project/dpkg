# Maintainer: Alexandru Balan <alxb421@gmail.com>
pkgname=pearos-settings
pkgver=26.7.0
pkgrel=5
pkgdesc="Settings for pearOS Goldwing"
arch=('all')
url="https://github.com/pearOS-archlinux/pearos-settings"
license="GPL-3"
section="misc"
priority="optional"
maintainer="Alexandru Balan <alxb421@gmail.com>"

builddepends=()

# usr/share/extras/wallpapers upstream ships 11 wallpaper sets; only
# Default/Dev/Dev2 are kept here (the rest were deleted from this dir
# entirely) to keep the built .deb under GitHub's 100MB single-file push
# limit for debian-package-repo - the full set was ~152MB, this cut it to
# ~43MB. Add more sets back individually if a real need comes up.

# pearos-keyring is Arch/pacman-specific (GPG keys for the pacman repo) and
# has no Debian equivalent - apt trust is handled separately (see
# ../importer/). Everything else from the Arch depends=() is kept, even
# though most of the pearos-* ones aren't packaged in this repo yet -
# installing this will fail until they are too, same situation
# pearos-window-borders was in before pearos-muternvf/pearos-window-tinter
# existed.
#
# pearos-appstore is Arch/AUR-specific (no such package on apt.pearos.xyz,
# confirmed against the repo's own Packages index) - the Debian edition
# uses gnome-software instead, so this depends on that in its place.
depends=(
    konsole
    kmail
    pearos-notes
    gnome-software
    pearos-calendar
    pearos-contacts
    pearos-notch
    pearos-todo
    pearos-calculator
    pearos-liquidgel
    pearos-window-borders
    pearos-icons
    pearos-zshconfig
    system-overview
)

build() {
    :
}

package() {
    mkdir -p "$pkgdir/etc" "$pkgdir/usr"
    cp -r "$startdir/etc/." "$pkgdir/etc/"
    cp -r "$startdir/usr/." "$pkgdir/usr/"
}
