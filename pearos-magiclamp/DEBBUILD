# Maintainer: Alexandru Balan <alxb421@gmail.com>
pkgname=pearos-magiclamp
pkgver=26.6
pkgrel=4
pkgdesc="KWin window minimization effect - Pearos Magic Lamp"
arch=('amd64')
url="https://github.com/koryboc/pearos-magiclamp"
license="GPL-2"
section="kde"
priority="optional"
maintainer="Alexandru Balan <alxb421@gmail.com>"

# Build-only tools/headers; not recorded as runtime deps.
builddepends=(
    build-essential
    cmake
    extra-cmake-modules
    kwin-dev
    libkf6config-dev
    libkf6configwidgets-dev
    libkf6coreaddons-dev
    libkf6kcmutils-dev
    libkf6windowsystem-dev
    qt6-base-dev
    libdrm-dev
    libvulkan-dev
    pkg-config
)

# libkwin6 is Debian's split-out package for libkwin.so.6; on Ubuntu-based
# distros (KDE neon, Kubuntu) that same library ships inside kwin-common
# instead, under no package literally named libkwin6 - so drop the
# auto-detected entry and depend on kwin-wayland (present under that name on
# both) with no pinned version instead.
depends_exclude=(
    libkwin6
)

# Extra runtime deps beyond what dpkg-shlibdeps auto-detects from the linked
# .so files (e.g. things only loaded at runtime, not linked at build time,
# or replacements for depends_exclude entries above).
depends=(
    kwin-wayland
)

build() {
    cmake -S "$startdir" -B "$srcdir/build" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build "$srcdir/build" --parallel
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/build"
}
