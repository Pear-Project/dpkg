pkgname=pearos-notes
pkgver=26.7.0
pkgrel=1
pkgdesc="pearOS Notes - modern Qt6 notes application for pearOS"
arch=('amd64')
url="https://github.com/arch-linux-gui/pearos-notes"
license="MIT"
section="utils"
priority="optional"
maintainer="Alexandru Balan <alxb421@gmail.com>"

builddepends=(
    build-essential
    cmake
    qt6-base-dev
    libkf6windowsystem-dev
)

depends=()

build() {
    cmake -S "$startdir" -B "$srcdir/build" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build "$srcdir/build" --parallel
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/build"
    install -d -m1777 "$pkgdir/usr/share/extras/pearos-notes"
}
