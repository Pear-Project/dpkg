pkgname=pearos-filesystem
pkgver=26.8
pkgrel=2
pkgdesc="pearOS Goldwing branding (os-release, issue, logo) for Debian-based systems"
arch=('all')
url="https://pearos.xyz"
license="GPL-3"
section="misc"
priority="optional"
maintainer="Alexandru Balan <alxb421@gmail.com>"

# This is deliberately a branding-only port of pearOS-archlinux/filesystem.
# That repo's PKGBUILD lays out an entire Arch root filesystem (/etc/passwd,
# shadow, fstab, hosts, the /bin -> usr/bin symlinks, sysusers, ...) because
# Arch has no separate base-files/base-passwd/netbase equivalent - that
# package IS the base system on Arch. On Debian/Ubuntu/KDE neon all of that
# already exists, owned by essential packages; shipping our own versions
# would conflict with (or on a forced install, corrupt) them. So only the
# purely cosmetic identity files are ported here.
builddepends=()
depends=()

build() {
    :
}

package() {
    install -Dm644 "$startdir/pearos-logo.png" "$pkgdir/usr/share/pixmaps/pearos-logo.png"
    install -Dm644 "$startdir/pearos-release" "$pkgdir/etc/pearos-release"

    # os-release and issue are owned by base-files on Debian/Ubuntu, so they
    # can't just be dropped in - preinst/postrm divert them properly instead.
    #
    # /etc/os-release ships as a symlink to ../usr/lib/os-release on Debian,
    # and some readers (e.g. neofetch) check /usr/lib/os-release *before*
    # /etc/os-release, breaking on the first match - diverting only /etc's
    # copy left /usr/lib/os-release as the untouched, unbranded original,
    # so those readers never saw pearOS branding at all. Divert both, from
    # the same source file.
    install -Dm644 "$startdir/os-release" "$pkgdir/etc/os-release"
    install -Dm644 "$startdir/os-release" "$pkgdir/usr/lib/os-release"
    install -Dm644 "$startdir/issue" "$pkgdir/etc/issue"
}

preinst="#!/bin/sh
set -e
dpkg-divert --package pearos-filesystem --add --rename --divert /etc/os-release.pearos-orig /etc/os-release >/dev/null
dpkg-divert --package pearos-filesystem --add --rename --divert /usr/lib/os-release.pearos-orig /usr/lib/os-release >/dev/null
dpkg-divert --package pearos-filesystem --add --rename --divert /etc/issue.pearos-orig /etc/issue >/dev/null
exit 0
"

postrm="#!/bin/sh
set -e
case \"\$1\" in
    remove)
        dpkg-divert --package pearos-filesystem --remove --rename --divert /etc/os-release.pearos-orig /etc/os-release >/dev/null
        dpkg-divert --package pearos-filesystem --remove --rename --divert /usr/lib/os-release.pearos-orig /usr/lib/os-release >/dev/null
        dpkg-divert --package pearos-filesystem --remove --rename --divert /etc/issue.pearos-orig /etc/issue >/dev/null
        ;;
esac
exit 0
"
