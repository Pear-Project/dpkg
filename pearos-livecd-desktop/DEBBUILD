pkgname=pearos-livecd-desktop
pkgver=22.03
pkgrel=2
pkgdesc="Default pearOS installer shortcut for the live desktop"
arch=('all')
url="https://github.com/pearOS-archlinux/pearos-livecd-desktop"
license="custom"
section="misc"
priority="optional"
maintainer="Alexandru Balan <alxb421@gmail.com>"

# Exec=bash bin_install is now wired up on $PATH by the ISO build itself
# (profiles/pear/customize.sh installs pearOS-installer's general_bin/
# bin_install there), so this icon does launch something. Installed 0644
# before, which KDE/Dolphin treats as an untrusted .desktop file needing a
# manual "Allow Launching" right-click every time -- 0755 (the +x bit) is
# what actually marks it trusted.
builddepends=()
depends=()

build() {
    :
}

package() {
    install -Dm755 "$startdir/system_install.desktop" "$pkgdir/etc/skel/Desktop/system_install.desktop"
}
